---
import CodeBlock from "./CodeBlock.astro";
import resetCss from "destyle.css/destyle.css?raw";
import tokensCss from "../../styles/tokens.css?raw";
import { buildPreviewDoc } from "../../lib/preview-doc.ts";
import type { PreviewDirection, PreviewPlacement } from "../../lib/snippets.ts";
import { formatSnippetHtmlForDisplay } from "../../lib/snippets.ts";

interface Props {
  id: string;
  title: string;
  html: string;
  css: string;
  js?: string;
  head?: string;
  previewHeight?: string;
  previewPlacement?: PreviewPlacement;
  previewPadding?: boolean;
  previewScroll?: boolean;
  previewDirection?: PreviewDirection;
  previewGap?: string;
  previewBackground?: string;
}

const {
  id,
  title,
  html,
  css,
  js,
  head,
  previewHeight = "400px",
  previewPlacement = "center",
  previewPadding = true,
  previewScroll = false,
  previewDirection,
  previewGap,
  previewBackground,
} = Astro.props;

const assetOrigin = new URL(import.meta.env.BASE_URL, Astro.url).href.replace(
  /\/+$/,
  "",
);

const previewDoc = await buildPreviewDoc({
  assetOrigin,
  resetCss,
  tokensCss,
  css,
  html,
  js,
  head,
  previewPlacement,
  previewPadding,
  previewDirection,
  previewGap,
  previewBackground,
});
const displayHtml = formatSnippetHtmlForDisplay(html, head);
const snippetTabsStyle = [
  previewHeight && `--snippet-panel-min-height: ${previewHeight}`,
  previewBackground && `--snippet-preview-background: ${previewBackground}`,
]
  .filter(Boolean)
  .join("; ");
---

<div
  class:list={[
    "c-snippet-tabs",
    "js-snippet-tabs",
    !previewPadding && "c-snippet-tabs--preview-no-padding",
    previewScroll && "c-snippet-tabs--preview-scroll",
  ]}
  style={snippetTabsStyle || undefined}
>
  <div class="c-snippet-tabs__header">
    <div
      class="c-snippet-tabs__list"
      role="tablist"
      aria-label={`${title} スニペット`}
    >
      <button
        id={`${id}-tab-preview`}
        class="c-snippet-tabs__tab c-snippet-tabs__tab--active js-snippet-tab"
        data-tab="preview"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls={`${id}-panel-preview`}>Preview</button
      >
      <span class="c-snippet-tabs__divider" aria-hidden="true"></span>
      <button
        id={`${id}-tab-html`}
        class="c-snippet-tabs__tab js-snippet-tab"
        data-tab="html"
        type="button"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        aria-controls={`${id}-panel-html`}>HTML</button
      >
      <button
        id={`${id}-tab-css`}
        class="c-snippet-tabs__tab js-snippet-tab"
        data-tab="css"
        type="button"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        aria-controls={`${id}-panel-css`}>CSS</button
      >
      {
        js && (
          <button
            id={`${id}-tab-js`}
            class="c-snippet-tabs__tab js-snippet-tab"
            data-tab="js"
            type="button"
            role="tab"
            aria-selected="false"
            tabindex="-1"
            aria-controls={`${id}-panel-js`}
          >
            JS
          </button>
        )
      }
    </div>
    <button
      class="c-snippet-tabs__open-preview js-open-preview-tab"
      type="button"
      aria-label={`${title} のプレビューを別タブで開く`}
      data-tooltip="別タブで開く"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M14 4h6v6M20 4l-9 9"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M20 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  <div class="c-snippet-tabs__panels">
    <section
      id={`${id}-panel-preview`}
      class="c-snippet-tabs__panel c-snippet-tabs__panel--active js-snippet-panel"
      data-panel="preview"
      role="tabpanel"
      aria-labelledby={`${id}-tab-preview`}
    >
      <div class="c-snippet-tabs__preview-scroll">
        <div class="c-snippet-tabs__preview-pad">
          <iframe
            class="c-snippet-tabs__preview js-preview-iframe"
            title={`${title} のプレビュー`}
            sandbox="allow-scripts"
            srcdoc={previewDoc}
            loading="lazy"></iframe>
        </div>
      </div>
      <div
        class="c-snippet-tabs__preview-loader js-preview-loader"
        role="status"
      >
        <span class="c-snippet-tabs__preview-spinner" aria-hidden="true"></span>
        <span class="c-snippet-tabs__preview-loader-text"
          >プレビューを読み込み中</span
        >
      </div>
    </section>

    <section
      id={`${id}-panel-html`}
      class="c-snippet-tabs__panel js-snippet-panel"
      data-panel="html"
      role="tabpanel"
      aria-labelledby={`${id}-tab-html`}
      hidden
    >
      <CodeBlock code={displayHtml} language="html" />
    </section>

    <section
      id={`${id}-panel-css`}
      class="c-snippet-tabs__panel js-snippet-panel"
      data-panel="css"
      role="tabpanel"
      aria-labelledby={`${id}-tab-css`}
      hidden
    >
      <CodeBlock code={css} language="css" />
    </section>

    {
      js && (
        <section
          id={`${id}-panel-js`}
          class="c-snippet-tabs__panel js-snippet-panel"
          data-panel="js"
          role="tabpanel"
          aria-labelledby={`${id}-tab-js`}
          hidden
        >
          <CodeBlock code={js} language="javascript" />
        </section>
      )
    }
  </div>
</div>

<style>
  .c-snippet-tabs {
    display: grid;
    row-gap: var(--space-2);
    min-width: 0;
  }

  @media (width > 960px) {
    .c-snippet-tabs {
      row-gap: var(--space-4);
    }
  }

  .c-snippet-tabs__header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
  }

  .c-snippet-tabs__list {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
    max-inline-size: 100%;
  }

  .c-snippet-tabs__divider {
    width: 1px;
    height: 1em;
    margin-inline: var(--space-1);
    background-color: var(--color-border-default);
  }

  .c-snippet-tabs__tab {
    padding-block: var(--space-1);
    padding-inline: var(--space-3);
    font-size: var(--font-size-sm);
    border-radius: var(--radius-sm);
  }

  .c-snippet-tabs__tab--active {
    color: var(--color-accent);
    background-color: var(--color-bg-accent);
  }

  .c-snippet-tabs__open-preview {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-touch-target);
    height: var(--size-touch-target);
    padding: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
  }

  .c-snippet-tabs__open-preview::after {
    position: absolute;
    bottom: calc(100% + var(--space-1));
    left: 50%;
    z-index: 1;
    visibility: hidden;
    padding-block: var(--space-1);
    padding-inline: var(--space-2);
    font-size: var(--font-size-xs);
    line-height: 1;
    color: var(--color-fg-default);
    white-space: nowrap;
    pointer-events: none;
    content: attr(data-tooltip);
    background-color: var(--color-bg-default);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    opacity: 0;
    transform: translateX(-50%);
    transition:
      opacity var(--transition-fast),
      visibility var(--transition-fast);
  }

  .c-snippet-tabs__open-preview:focus-visible::after {
    visibility: visible;
    opacity: 1;
  }

  @media (any-hover: hover) {
    .c-snippet-tabs__tab {
      transition: background-color var(--transition-fast);
    }

    .c-snippet-tabs__tab:not(.c-snippet-tabs__tab--active):hover {
      background-color: var(--color-bg-surface);
    }

    .c-snippet-tabs__open-preview {
      transition: background-color var(--transition-fast);
    }

    .c-snippet-tabs__open-preview:hover {
      background-color: var(--color-bg-surface);
    }

    .c-snippet-tabs__open-preview:hover::after {
      visibility: visible;
      opacity: 1;
    }
  }

  .c-snippet-tabs--preview-no-padding .c-snippet-tabs__panels {
    --snippet-preview-padding: 0;
    --snippet-preview-content-height: max(
      var(--snippet-panel-height, 200px),
      var(--snippet-panel-min-height, 400px)
    );
    --snippet-preview-iframe-height: var(--snippet-preview-content-height);
    --snippet-preview-frame-height: max(
      var(--snippet-preview-content-height),
      var(--snippet-panel-min-height, 400px)
    );
  }

  .c-snippet-tabs__panels {
    --snippet-preview-padding: var(--space-4);
    --snippet-preview-border: 1px;
    --snippet-preview-content-height: max(
      var(--snippet-panel-height, 200px),
      calc(
        var(--snippet-panel-min-height, 0px) - var(--snippet-preview-padding) *
          2
      )
    );
    --snippet-preview-iframe-height: var(--snippet-preview-content-height);
    --snippet-preview-frame-height: max(
      calc(
        var(--snippet-preview-content-height) + var(--snippet-preview-padding) *
          2
      ),
      calc(
        var(--snippet-panel-min-height, 0px) + var(--snippet-preview-border) * 2
      )
    );

    display: grid;
    height: var(--snippet-preview-frame-height);
    overflow: hidden;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
  }

  .c-snippet-tabs--preview-scroll.c-snippet-tabs--preview-no-padding
    .c-snippet-tabs__panels {
    --snippet-preview-iframe-height: max(
      var(--snippet-panel-height, 0px),
      var(--snippet-panel-min-height, 400px)
    );
    --snippet-preview-frame-height: calc(
      var(--snippet-panel-min-height, 400px) + var(--snippet-preview-border) * 2
    );
  }

  .c-snippet-tabs--preview-scroll .c-snippet-tabs__panels {
    --snippet-preview-iframe-height: max(
      var(--snippet-panel-height, 0px),
      calc(
        var(--snippet-panel-min-height, 0px) - var(--snippet-preview-padding) *
          2
      )
    );
    --snippet-preview-frame-height: calc(
      var(--snippet-panel-min-height, 400px) + var(--snippet-preview-border) * 2
    );
  }

  @media (width > 960px) {
    .c-snippet-tabs__panels {
      --snippet-preview-padding: var(--space-6);
    }

    .c-snippet-tabs--preview-no-padding .c-snippet-tabs__panels {
      --snippet-preview-padding: 0;
    }
  }

  .c-snippet-tabs__panel {
    display: none;
    grid-area: 1 / 1;
    min-height: 0;
  }

  .c-snippet-tabs__panel--active {
    display: block;
    height: 100%;
  }

  .c-snippet-tabs__panel[data-panel="preview"] {
    position: relative;
    background-color: var(--snippet-preview-background, transparent);
  }

  .c-snippet-tabs__preview-scroll {
    height: 100%;
    overflow: hidden;
  }

  .c-snippet-tabs--preview-scroll .c-snippet-tabs__preview-scroll {
    overflow: auto;
    scrollbar-color: var(--color-preview-scrollbar-thumb)
      var(--color-preview-scrollbar-track);
    scrollbar-width: thin;
  }

  .c-snippet-tabs--preview-scroll
    .c-snippet-tabs__preview-scroll::-webkit-scrollbar:vertical {
    width: var(--scrollbar-preview-size);
  }

  .c-snippet-tabs--preview-scroll
    .c-snippet-tabs__preview-scroll::-webkit-scrollbar:horizontal {
    height: var(--scrollbar-preview-size);
  }

  .c-snippet-tabs--preview-scroll
    .c-snippet-tabs__preview-scroll::-webkit-scrollbar-track {
    background-color: var(--color-preview-scrollbar-track);
  }

  .c-snippet-tabs--preview-scroll
    .c-snippet-tabs__preview-scroll::-webkit-scrollbar-thumb {
    background-color: var(--color-preview-scrollbar-thumb);
    border-radius: var(--radius-sm);
  }

  .c-snippet-tabs--preview-scroll
    .c-snippet-tabs__preview-scroll::-webkit-scrollbar-corner {
    background-color: var(--color-preview-scrollbar-track);
  }

  @media (any-hover: hover) {
    .c-snippet-tabs--preview-scroll
      .c-snippet-tabs__preview-scroll::-webkit-scrollbar-thumb:hover {
      background-color: var(--color-preview-scrollbar-thumb-hover);
    }
  }

  .c-snippet-tabs__preview-pad {
    padding: var(--snippet-preview-padding);
  }

  .c-snippet-tabs__preview {
    display: block;
    width: 100%;
    height: var(--snippet-preview-iframe-height);
    overflow: hidden;
    border: 0;
  }

  .c-snippet-tabs__preview-loader {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    background-color: var(
      --snippet-preview-background,
      var(--color-bg-default)
    );
  }

  .c-snippet-tabs__preview-loader[hidden] {
    display: none;
  }

  .c-snippet-tabs__preview-spinner {
    display: block;
    width: var(--space-8);
    height: var(--space-8);
    border: 2px solid var(--color-border-default);
    border-top-color: var(--color-accent);
    border-radius: var(--radius-full);
    animation: c-snippet-tabs-spin 0.7s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .c-snippet-tabs__preview-spinner {
      animation-duration: 1.6s;
    }
  }

  @keyframes c-snippet-tabs-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .c-snippet-tabs__preview-loader-text {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }
</style>

<script>
  import "../../scripts/tabs.ts";
  import "../../scripts/preview-iframe.ts";
  import "../../scripts/open-preview-tab.ts";
</script>
