---
interface Link {
  href: string;
  label: string;
}
interface Props {
  prev?: Link;
  next?: Link;
}
const { prev, next } = Astro.props;
---

<nav class="c-prev-next" aria-label="前後のページ">
  {
    prev && (
      <a class="c-prev-next__link c-prev-next__link--prev" href={prev.href}>
        <span class="c-prev-next__label">
          <svg
            class="c-prev-next__icon"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.8" />
          </svg>
          {prev.label}
        </span>
        <span class="c-prev-next__hint">Previous</span>
      </a>
    )
  }
  {
    next && (
      <a class="c-prev-next__link c-prev-next__link--next" href={next.href}>
        <span class="c-prev-next__label">
          {next.label}
          <svg
            class="c-prev-next__icon"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" />
          </svg>
        </span>
        <span class="c-prev-next__hint">Next</span>
      </a>
    )
  }
</nav>

<style>
  .c-prev-next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    width: 100%;
  }

  .c-prev-next__link {
    display: grid;
    flex: 1 1 8rem;
    row-gap: var(--space-2);
    min-width: min(100%, 8rem);
    padding-block: var(--space-4);
    padding-inline: var(--space-6);
    background-color: var(--color-bg-default);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
  }

  @media (any-hover: hover) {
    .c-prev-next__link {
      transition: background-color var(--transition-fast);
    }

    .c-prev-next__link:hover {
      background-color: var(--color-bg-surface);
    }
  }

  .c-prev-next__link:only-child {
    flex: 0 1 calc(50% - var(--space-3) / 2);
    max-width: calc(50% - var(--space-3) / 2);
  }

  .c-prev-next__link--next:only-child {
    margin-left: auto;
  }

  .c-prev-next__label {
    display: grid;
    grid-auto-flow: column;
    column-gap: var(--space-1);
    align-items: center;
    justify-content: start;
    min-width: 0;
    font-size: var(--font-size-sm);
    overflow-wrap: anywhere;
  }

  .c-prev-next__link--next .c-prev-next__label {
    justify-content: end;
  }

  .c-prev-next__hint {
    margin-left: var(--space-1);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-normal);
    color: var(--color-fg-subtle);
  }

  .c-prev-next__link--next .c-prev-next__hint {
    justify-self: end;
    margin-right: var(--space-1);
  }
</style>
