---

---

<button
  class="c-theme-toggle js-theme-toggle"
  type="button"
  aria-label="カラーテーマを切り替える"
>
  <svg
    class="c-theme-toggle__icon c-theme-toggle__icon--sun"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M4.8 4.8l1.4 1.4M17.8 17.8l1.4 1.4M2.5 12h2M19.5 12h2M4.8 19.2l1.4-1.4M17.8 6.2l1.4-1.4"
    ></path>
  </svg>

  <svg
    class="c-theme-toggle__icon c-theme-toggle__icon--moon"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .c-theme-toggle {
    display: grid;
    place-items: center;
    width: var(--size-touch-target);
    height: var(--size-touch-target);
    color: var(--color-fg-default);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  @media (any-hover: hover) {
    .c-theme-toggle {
      transition: background-color var(--transition-fast);
    }

    .c-theme-toggle:hover {
      background-color: var(--color-bg-surface);
    }
  }

  .c-theme-toggle__icon {
    grid-area: 1 / 1;
  }
</style>

<script>
  import "../../scripts/theme-toggle.ts";
</script>
