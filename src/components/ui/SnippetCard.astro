---
import { getSnippetFeatures } from "../../lib/css-features";
import type { Snippet } from "../../lib/snippets";
import FeatureBadges from "./FeatureBadges.astro";
import SnippetTabs from "./SnippetTabs.astro";

interface Props {
  snippet: Snippet;
}

const { snippet } = Astro.props;
const featureData = getSnippetFeatures(snippet.css, snippet.meta.features);
---

<article class="c-snippet-card" id={snippet.slug}>
  <header class="c-snippet-card__header">
    <h2 class="c-snippet-card__title">{snippet.meta.title}</h2>
    {
      snippet.meta.description && (
        <p class="c-snippet-card__description">{snippet.meta.description}</p>
      )
    }
    <FeatureBadges data={featureData} />
  </header>

  <SnippetTabs
    id={snippet.slug}
    title={snippet.meta.title}
    html={snippet.html}
    css={snippet.css}
    js={snippet.js}
    head={snippet.head}
    previewPlacement={snippet.meta.previewPlacement}
    previewPadding={snippet.meta.previewPadding}
    previewScroll={snippet.meta.previewScroll}
    previewDirection={snippet.meta.previewDirection}
    previewGap={snippet.meta.previewGap}
    previewBackground={snippet.meta.previewBackground}
  />
</article>

<style>
  .c-snippet-card {
    display: grid;
    row-gap: var(--space-2);
    padding-block: var(--space-8) var(--space-4);
    padding-inline: var(--space-4);
    background-color: var(--color-bg-default);
    border-radius: var(--radius-xl);
  }

  @media (width > 960px) {
    .c-snippet-card {
      row-gap: var(--space-6);
      padding-block: var(--space-12) var(--space-6);
      padding-inline: var(--space-6);
    }
  }

  .c-snippet-card__header {
    display: grid;
    row-gap: var(--space-1);
  }

  .c-snippet-card__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
  }

  .c-snippet-card__description {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-fg-subtle);
  }
</style>
