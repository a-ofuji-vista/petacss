---
import { withBase } from "../../lib/paths.ts";

const mascotSrc = withBase("brand/mascot.gif");
const wordmarkUrl = `url("${withBase("brand/wordmark.svg")}")`;
---

<div class="l-footer-brand" style={`--footer-brand-wordmark: ${wordmarkUrl}`}>
  <img
    class="l-footer-brand__mascot"
    src={mascotSrc}
    alt=""
    width="40"
    height="40"
  />
  <span class="l-footer-brand__wordmark" role="img" aria-label="PETA CSS"
  ></span>
</div>

<style>
  .l-footer-brand {
    display: grid;
    row-gap: var(--space-8);
  }

  .l-footer-brand__mascot {
    justify-self: center;
  }

  .l-footer-brand__wordmark {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 723 / 135;
    background-color: var(--color-bg-surface);
    mask-image: var(--footer-brand-wordmark);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: 100% 100%;
  }
</style>
