---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

<aside class="l-toc js-toc" aria-label="ページ内目次">
  {
    headings.length > 0 && (
      <>
        <h2 class="l-toc__heading">Contents</h2>
        <ul class="l-toc__list">
          {headings.map((h) => (
            <li class="l-toc__item">
              <a class="l-toc__link js-toc-link" href={`#${h.slug}`}>
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</aside>

<style>
  .l-toc {
    display: none;
  }

  @media (width > 1280px) {
    .l-toc {
      position: sticky;
      top: var(--layout-header-height);
      display: block;
      align-self: start;
      padding-block: var(--space-16);
      padding-inline: var(--space-6);
    }
  }

  .l-toc__heading {
    margin-bottom: var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-fg-default);
  }

  .l-toc__list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .l-toc__link {
    display: block;
    padding: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-fg-inactive);
    border-radius: var(--radius-sm);
  }

  @media (any-hover: hover) {
    .l-toc__link {
      transition: color var(--transition-fast);
    }

    .l-toc__link:hover {
      color: var(--color-fg-default);
    }
  }

  .l-toc__link--active {
    color: var(--color-fg-default);
  }
</style>

<script>
  import "../../scripts/toc.ts";
</script>
