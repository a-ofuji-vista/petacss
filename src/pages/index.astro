---
import BaseLayout from "../layouts/BaseLayout.astro";
import PrevNext from "../components/ui/PrevNext.astro";
import SnippetCategoryCard from "../components/ui/SnippetCategoryCard.astro";
import { getCategoryTree, getSubCategoryCounts } from "../lib/snippets";

const FEATURED_SNIPPET_SLUGS = ["button", "card", "heading", "modal"];

const subCategoryCounts = getSubCategoryCounts();
const allCategories = getCategoryTree().flatMap((t) =>
  t.subCategories.map((sub) => ({
    name: sub.label,
    href: `/snippets/${sub.slug}`,
    count: subCategoryCounts.get(sub.slug) ?? 0,
    slug: sub.slug,
  })),
);
const categories = FEATURED_SNIPPET_SLUGS.flatMap((slug) => {
  const item = allCategories.find((c) => c.slug === slug);
  return item ? [item] : [];
});

const headings = [
  { depth: 2, slug: "about", text: "PETA CSS とは" },
  { depth: 2, slug: "features", text: "スニペットの特徴" },
  { depth: 2, slug: "usage", text: "使い方" },
];
---

<BaseLayout
  title="What is PETA CSS?"
  description="Web サイトでよく使う UI パーツを、コピー＆ペーストですぐ使える形で公開しているスニペット集です。"
  headings={headings}
>
  <article class="p-about">
    <header class="p-about__header">
      <h1 class="p-about__title">What is PETA CSS?</h1>
      <p class="p-about__lead">
        Web サイトでよく使う UI
        パーツを、コピー＆ペーストですぐ使える形で公開しているスニペット集です。
      </p>
    </header>

    <img
      class="p-about__hero p-about__hero--light"
      src="/images/about-hero-light.webp"
      alt="PETA CSS のイメージ"
      width="1404"
      height="790"
      loading="lazy"
    />
    <img
      class="p-about__hero p-about__hero--dark"
      src="/images/about-hero-dark.webp"
      alt="PETA CSS のイメージ"
      width="1404"
      height="790"
      loading="lazy"
    />

    <div class="p-about__sections">
      <section class="p-about__section">
        <h2 class="p-about__heading" id="about">PETA CSS とは</h2>
        <p>
          特定のフレームワークに縛られず、HTML / CSS / JavaScript
          をそのままコピーして、どんなプロジェクトにも取り込めます。Google Fonts
          や Embla Carousel
          などが必要なスニペットもありますが、依存関係は各スニペットに記載しています。
        </p>
      </section>

      <section class="p-about__section">
        <h2 class="p-about__heading" id="features">スニペットの特徴</h2>
        <ul class="p-about__list">
          <li>特定のフレームワークやビルド環境がなくても使える</li>
          <li>
            HTML / CSS / JavaScript
            を分けて公開しているので、必要なコードだけ取り出せる
          </li>
          <li>
            Preview
            タブで見た目を確認してからコピーでき、別タブで開くこともできる
          </li>
          <li>CSS 機能を自動検出し、対応ブラウザをバッジで表示</li>
        </ul>
      </section>

      <section class="p-about__section">
        <h2 class="p-about__heading" id="usage">使い方</h2>
        <p>
          スニペットの HTML / CSS（必要なら
          JS）をコピーし、自分のプロジェクトに貼り付けて使います。
        </p>
        <p>
          CSS には <code>/* reset */</code>
          と書かれたセクションが含まれています。スニペット単体でも見た目が崩れないよう、要素のデフォルトスタイルを打ち消すためのものです。プロジェクトにリセット
          CSS や、同等のベーススタイルが既にある場合は、このセクションを削除してかまいません。
        </p>
      </section>
    </div>
    <div class="p-about__snippet-list-wrap">
      <ul class="p-about__snippet-list">
        {
          categories.map((item) => (
            <li class="p-about__snippet-list-item">
              <SnippetCategoryCard
                name={item.name}
                href={item.href}
                count={item.count}
              />
            </li>
          ))
        }
      </ul>
    </div>
    <div class="p-about__cta">
      <a class="p-about__cta-link" href="/snippets">
        <span class="p-about__cta-body">
          <span class="p-about__cta-label">All snippets</span>
          <span class="p-about__cta-hint">すべてのスニペットを見る</span>
        </span>
        <span class="p-about__cta-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path
              d="M8 5l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </a>
    </div>
  </article>
  <PrevNext next={{ href: "/changelog", label: "Update History" }} />
</BaseLayout>

<style>
  .p-about__header {
    margin-inline: var(--space-6);
  }

  .p-about__title {
    font-size: var(--font-size-3xl);
    font-style: italic;
    font-weight: var(--font-weight-bold);
  }

  .p-about__lead {
    margin-top: var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-fg-subtle);
  }

  .p-about__sections {
    display: grid;
    row-gap: var(--space-1);
    margin-top: var(--space-8);
  }

  .p-about__section {
    display: grid;
    row-gap: var(--space-4);
    padding: var(--space-9) var(--space-6);
    background-color: var(--color-bg-default);
    border-radius: var(--radius-xl);
  }

  .p-about__heading {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
  }

  .p-about__section p {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .p-about__hero {
    width: 100%;
    height: auto;
    margin-top: var(--space-8);
    border-radius: var(--radius-lg);
  }

  .p-about__list {
    display: grid;
    row-gap: var(--space-2);
    padding-left: var(--space-6);
  }

  .p-about__list li {
    font-size: var(--font-size-sm);
    list-style: disc outside;
  }

  .p-about__snippet-list-wrap {
    position: relative;
    margin-top: var(--space-4);
  }

  .p-about__snippet-list-wrap::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: min(55%, 200px);
    pointer-events: none;
    content: "";
    background: linear-gradient(to bottom, transparent, var(--color-bg-main));
  }

  .p-about__snippet-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .p-about__cta {
    max-width: 300px;
    margin-inline: auto;
    margin-top: var(--space-4);
  }

  .p-about__cta-link {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-8);
    color: var(--color-bg-default);
    background: var(--gradient-cta);
    border-radius: var(--radius-full);
  }

  .p-about__cta-body {
    display: grid;
    row-gap: var(--space-1);
  }

  .p-about__cta-label {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
  }

  .p-about__cta-hint {
    font-size: var(--font-size-sm);
    color: color-mix(in srgb, var(--color-bg-default) 72%, transparent);
  }

  .p-about__cta-icon {
    display: grid;
    place-items: center;
    width: var(--size-touch-target);
    height: var(--size-touch-target);
    background-color: color-mix(
      in srgb,
      var(--color-bg-default) 16%,
      transparent
    );
    border-radius: var(--radius-md);
  }

  @media (any-hover: hover) {
    .p-about__cta-link {
      transition: filter var(--transition-fast);
    }

    .p-about__cta-link:hover {
      filter: brightness(1.08);
    }

    .p-about__cta-icon {
      transition: translate var(--transition-fast);
    }

    .p-about__cta-link:hover .p-about__cta-icon {
      translate: var(--space-1) 0;
    }
  }
</style>
