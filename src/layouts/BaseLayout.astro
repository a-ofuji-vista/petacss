---
import ReleaseBar from "../components/structures/ReleaseBar.astro";
import Header from "../components/structures/Header.astro";
import GlobalNav from "../components/structures/GlobalNav.astro";
import Toc from "../components/structures/Toc.astro";
import Footer from "../components/structures/Footer.astro";
import FooterBrand from "../components/structures/FooterBrand.astro";
import { withBase } from "../lib/paths.ts";
import { buildThemeInitScript } from "../lib/theme.ts";
import "../styles/global.css";

const themeInitScript = buildThemeInitScript();

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  headings?: Heading[];
  showReleaseBar?: boolean;
}

const SITE_DESCRIPTION =
  "Web サイトでよく使う UI パーツを、コピー＆ペーストですぐ使える形で公開しているスニペット集です。";

const {
  title,
  description = SITE_DESCRIPTION,
  headings = [],
  showReleaseBar = true,
} = Astro.props;

const pageTitle = `${title} | PETA CSS`;
const ogImageURL = new URL(withBase("og/ogp.jpg"), Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <script is:inline set:html={themeInitScript} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700&family=Noto+Sans+JP:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class:list={["l-layout", showReleaseBar && "l-layout--release"]}>
    {showReleaseBar && <ReleaseBar />}
    <Header />
    <div class="l-layout__container">
      <div class="l-layout__body">
        <GlobalNav />
        <main class="l-layout__main">
          <div class="l-layout__main-inner">
            <div class="l-layout__main-content">
              <slot />
            </div>
            <FooterBrand />
          </div>
        </main>
        <Toc headings={headings} />
      </div>
    </div>
    <Footer />

    <style>
      .l-layout {
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: 100dvh;
      }

      .l-layout--release {
        grid-template-rows: auto auto 1fr auto;
      }

      .l-layout__container {
        min-height: 0;
        background-color: var(--color-bg-surface);
        border-radius: var(--radius-2xl);
      }

      .l-layout__body {
        display: grid;
        grid-template-rows: 1fr;
        grid-template-columns: 1fr;
        width: 100%;
        max-width: var(--layout-max-width);
        min-height: 100%;
        margin-inline: auto;
      }

      @media (width > 960px) {
        .l-layout__body {
          grid-template-columns: var(--layout-sidebar-width) 1fr;
        }
      }

      @media (width > 1280px) {
        .l-layout__body {
          grid-template-columns: var(--layout-sidebar-width) 1fr var(
              --layout-sidebar-width
            );
        }
      }

      .l-layout__main {
        min-width: 0;
        padding-block: var(--space-10);
        padding-inline: var(--space-4);
        background-color: var(--color-bg-main);
        background-image:
          linear-gradient(90deg, var(--color-bg-surface) 1px, transparent 1px),
          linear-gradient(var(--color-bg-surface) 1px, transparent 1px);
        background-size: 20px 20px;
        border-radius: var(--radius-2xl);
      }

      @media (width > 960px) {
        .l-layout__main {
          padding-block: var(--space-16);
          padding-inline: var(--space-6);
          border-radius: 0 var(--radius-2xl) var(--radius-2xl) 0;
        }
      }

      @media (width > 1280px) {
        .l-layout__main {
          border-radius: 0;
        }
      }

      .l-layout__main-inner {
        display: grid;
        grid-template-rows: 1fr auto;
        gap: var(--space-4);
        width: 100%;
        max-width: var(--layout-main-max-width);
        min-height: 100%;
        margin-inline: auto;
      }

      .l-layout__main-content {
        display: grid;
        gap: var(--space-4);
        align-content: start;
        min-height: 0;
      }

      @media (width > 960px) {
        .l-layout__main-inner {
          gap: var(--space-8);
        }

        .l-layout__main-content {
          gap: var(--space-8);
        }
      }
    </style>
  </body>
</html>
